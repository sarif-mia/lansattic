{%- doc -%}
  This component is used to generate a vendor link, by checking the existence of a vendor collection, and falling back to the automatic one if none is found.

  @param {string} vendor - the vendor to use
  @param {string} [class] - extra classes to be added on the vendor
{%- enddoc -%}

{%- if vendor == '我的商店' -%}
  <a href="{{ routes.all_products_collection_url }}" class="vendor {{ class }}">{{ shop.name | escape }}</a>
{%- elsif vendor != blank -%}
  {%- assign collection_handle = vendor | handle -%}
  {%- assign collection_for_vendor = collections[collection_handle] -%}

  {%- if collection_for_vendor != blank -%}
    {%- assign url = collection_for_vendor.url -%}
  {%- else -%}
    {%- assign url = vendor | url_for_vendor -%}
  {%- endif -%}

  <a href="{{ url }}" class="vendor {{ class }}">
    {{- vendor -}}
  </a>
{%- endif -%}
