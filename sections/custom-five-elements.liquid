{% comment %}
  Lansattic — Five Elements
  Add this file to: sections/lansattic-five-elements.liquid
{% endcomment %}

{% liquid
  assign section_id = 'five-elements-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="five-elements"
  style="
    --fe-bg: {{ section.settings.background_color }};
    --fe-text: {{ section.settings.text_color }};
    --fe-line: {{ section.settings.line_color }};
    --fe-dot: {{ section.settings.dot_color }};
    --fe-desktop-pad: {{ section.settings.desktop_padding }}px;
    --fe-mobile-pad: {{ section.settings.mobile_padding }}px;
  "
>
  <div{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} class="five-elements__inner page-width" style="scroll-margin-top: 116px;">
    <header class="five-elements__header">
      {% if section.settings.eyebrow != blank %}
        <p class="five-elements__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="five-elements__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="five-elements__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    <div class="five-elements__scroller" aria-label="{{ section.settings.heading | escape }}">
      <div class="five-elements__grid">
        {% for block in section.blocks %}
          {% liquid
            assign element_tag = 'div'
            if block.settings.link != blank
              assign element_tag = 'a'
            endif
          %}

          <{{ element_tag }}
            class="five-elements__item"
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="five-elements__visual">
              {% if block.settings.image != blank %}
                {{ block.settings.image
                  | image_url: width: 720
                  | image_tag:
                    loading: 'lazy',
                    widths: '240, 360, 480, 720',
                    sizes: '(max-width: 749px) 52vw, 20vw',
                    class: 'five-elements__image',
                    alt: block.settings.title
                }}
              {% else %}
                <span class="five-elements__symbol" aria-hidden="true">
                  <span></span>
                </span>
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <h3 class="five-elements__title">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.quality != blank %}
              <p class="five-elements__quality">{{ block.settings.quality | escape }}</p>
            {% endif %}
          </{{ element_tag }}>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #{{ section_id }} {
    background: var(--fe-bg);
    color: var(--fe-text);
    padding: var(--fe-desktop-pad) 0;
    overflow: hidden;
  }

  #{{ section_id }} .five-elements__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: clamp(24px, 4vw, 64px);
  }

  #{{ section_id }} .five-elements__header {
    max-width: 980px;
    margin: 0 auto 64px;
    text-align: center;
  }

  #{{ section_id }} .five-elements__eyebrow {
    margin: 0 0 8px;
    color: inherit;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  #{{ section_id }} .five-elements__heading {
    margin: 0;
    color: inherit;
    font-family: var(--heading-font-family, Georgia, serif);
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -.025em;
  }

  #{{ section_id }} .five-elements__description {
    max-width: 900px;
    margin: 24px auto 0;
    color: inherit;
    font-size: clamp(16px, 1.5vw, 21px);
    line-height: 1.55;
    opacity: .92;
  }

  #{{ section_id }} .five-elements__description p {
    margin: 0;
  }

  #{{ section_id }} .five-elements__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 5 }}, minmax(0, 1fr));
    border-top: 1px solid var(--fe-line);
  }

  #{{ section_id }} .five-elements__item {
    min-width: 0;
    padding: 54px 24px 58px;
    color: inherit;
    text-align: center;
    text-decoration: none;
    border-right: 1px solid var(--fe-line);
    transition: background-color .25s ease, transform .25s ease;
  }

  #{{ section_id }} .five-elements__item:last-child {
    border-right: 0;
  }

  #{{ section_id }} a.five-elements__item:hover {
    background: rgb(255 255 255 / 5%);
  }

  #{{ section_id }} a.five-elements__item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  #{{ section_id }} .five-elements__visual {
    width: min(100%, 190px);
    aspect-ratio: 1 / 1;
    margin: 0 auto 30px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
  }

  #{{ section_id }} .five-elements__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    border-radius: 50% !important;
  }

  #{{ section_id }} .five-elements__symbol {
    width: 78px;
    height: 78px;
    display: grid;
    place-items: center;
    border: 1px solid var(--fe-line);
    border-radius: 50%;
  }

  #{{ section_id }} .five-elements__symbol span {
    width: 42px;
    height: 42px;
    background: var(--fe-dot);
    border-radius: 50%;
  }

  #{{ section_id }} .five-elements__title {
    margin: 0;
    color: inherit;
    font-family: var(--heading-font-family, Georgia, serif);
    font-size: clamp(27px, 2.5vw, 38px);
    font-weight: 400;
    line-height: 1.15;
  }

  #{{ section_id }} .five-elements__quality {
    margin: 22px 0 0;
    color: inherit;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .86;
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding: var(--fe-mobile-pad) 0;
    }

    #{{ section_id }} .five-elements__inner {
      padding-inline: 0;
    }

    #{{ section_id }} .five-elements__header {
      margin: 0 auto 40px;
      padding-inline: 22px;
    }

    #{{ section_id }} .five-elements__eyebrow {
      font-size: 11px;
    }

    #{{ section_id }} .five-elements__heading {
      font-size: clamp(38px, 12vw, 50px);
    }

    #{{ section_id }} .five-elements__description {
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.5;
    }

    #{{ section_id }} .five-elements__scroller {
      padding-inline: 18px;
    }

    #{{ section_id }} .five-elements__grid {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .five-elements__item {
      width: auto;
      min-width: 0;
      padding: 30px 12px 34px;
      border-right: 1px solid var(--fe-line);
      border-bottom: 1px solid var(--fe-line);
    }

    #{{ section_id }} .five-elements__item:nth-child(2n) {
      border-right: 0;
    }

    #{{ section_id }} .five-elements__item:last-child:nth-child(odd) {
      width: 50%;
      grid-column: 1 / -1;
      justify-self: center;
      border-right: 0;
      border-bottom: 0;
    }

    #{{ section_id }} .five-elements__visual {
      width: clamp(108px, 31vw, 132px);
      height: clamp(108px, 31vw, 132px);
      max-width: none;
      aspect-ratio: auto;
      margin-bottom: 20px;
      border-radius: 50%;
    }

    #{{ section_id }} .five-elements__title {
      font-size: clamp(25px, 8vw, 31px);
    }

    #{{ section_id }} .five-elements__quality {
      margin-top: 13px;
      font-size: 10px;
      letter-spacing: .12em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .five-elements__item {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Five Elements",
  "tag": "section",
  "class": "section-five-elements",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Homepage anchor ID",
      "info": "Use letters only, without #.",
      "default": "elements"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP BY INTENTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Five Elements"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A design language inspired by cycles of nature. Choose the quality you want to keep close.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#315C4E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#F7F3EA"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Divider colour",
      "default": "#789487"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Placeholder dot colour",
      "default": "#527568"
    },
    {
      "type": "range",
      "id": "desktop_padding",
      "min": 60,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Desktop vertical spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile vertical spacing",
      "default": 68
    }
  ],
  "blocks": [
    {
      "type": "element",
      "name": "Element",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Element image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Wood"
        },
        {
          "type": "text",
          "id": "quality",
          "label": "Quality",
          "default": "GROWTH"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection or page link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Five Elements",
      "blocks": [
        { "type": "element", "settings": { "title": "Wood", "quality": "GROWTH" } },
        { "type": "element", "settings": { "title": "Fire", "quality": "VITALITY" } },
        { "type": "element", "settings": { "title": "Earth", "quality": "GROUNDING" } },
        { "type": "element", "settings": { "title": "Metal", "quality": "CLARITY" } },
        { "type": "element", "settings": { "title": "Water", "quality": "STILLNESS" } }
      ]
    }
  ]
}
{% endschema %}
