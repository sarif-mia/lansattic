<style>
  #shopify-section-{{ section.id }} .lansattic-collection-image {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
</style>

{%- assign banner_alt = section.settings.image_alt -%}
{%- if section.settings.image != blank -%}
  {{- section.settings.image | image_url: width: 2400 | image_tag: class: 'lansattic-collection-image', widths: '375,550,750,1100,1500,2000,2400', sizes: '100vw', alt: banner_alt, loading: 'eager', fetchpriority: 'high' -}}
{%- elsif section.settings.image_asset != blank -%}
  <img
    class="lansattic-collection-image"
    src="{{ section.settings.image_asset | asset_url }}"
    srcset="{{ section.settings.image_asset | asset_img_url: '400x' }} 400w, {{ section.settings.image_asset | asset_img_url: '750x' }} 750w, {{ section.settings.image_asset | asset_img_url: '1100x' }} 1100w, {{ section.settings.image_asset | asset_img_url: '1500x' }} 1500w, {{ section.settings.image_asset | asset_url }} 2109w"
    sizes="100vw"
    width="2109"
    height="746"
    alt="{{ banner_alt | escape }}"
    loading="eager"
    fetchpriority="high"
  >
{%- endif -%}

{% schema %}
{
  "name": "Collection image banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Theme image asset",
      "info": "Used when the banner image picker is empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "Jewelry — Handcrafted jewelry inspired by natural stones and timeless details. A natural stone pendant necklace on warm linen."
    }
  ],
  "presets": [{ "name": "Collection image banner" }]
}
{% endschema %}
