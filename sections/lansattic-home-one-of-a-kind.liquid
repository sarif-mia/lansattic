{% render 'lansattic-home-styles', section: section %}
<div id="lh-{{section.id}}" class="lansattic-home-section">
<section class="lhone"><div class="lhonem">{% if section.settings.one_image != blank %}{{section.settings.one_image|image_url:width:1600|image_tag:loading:'lazy'}}{% else %}{{'image'|placeholder_svg_tag}}{% endif %}</div><div class="lhoneb"><p class="lhk">{{ section.settings.copy_1 | escape | newline_to_br }}</p><h2 class="lht">{{ section.settings.copy_2 | escape | newline_to_br }}</h2><p class="lhp">{{ section.settings.copy_3 | escape | newline_to_br }}</p><div><a class="lhbtn" href="{{section.settings.one_link}}">{{ section.settings.one_cta_label | default: 'Explore one of a kind' }}</a></div></div></section>
</div>

{% schema %}
{
  "name": "Lansattic One of a Kind",
  "settings": [
    {
      "type": "textarea",
      "id": "copy_1",
      "label": "Text 1",
      "default": "One of a Kind"
    },
    {
      "type": "textarea",
      "id": "copy_2",
      "label": "Heading 2",
      "default": "Designed once.\nNever repeated."
    },
    {
      "type": "textarea",
      "id": "copy_3",
      "label": "Text 3",
      "default": "Natural jade, pearls, gemstones and woods carry their own variations in color, texture and form. Some Lansattic pieces exist only once. Once found, it may never appear again."
    },
    {
      "type": "image_picker",
      "id": "one_image",
      "label": "One of a Kind feature image"
    },
    {
      "type": "text",
      "id": "one_cta_label",
      "label": "One of a Kind CTA text",
      "default": "EXPLORE ONE OF A KIND"
    },
    {
      "type": "url",
      "id": "one_link",
      "label": "One of a Kind CTA link"
    },
    {
      "type": "select",
      "id": "card_image_ratio",
      "label": "Card image ratio",
      "options": [
        {
          "value": "4/5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "3/4",
          "label": "Tall portrait (3:4)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3/2",
          "label": "Landscape (3:2)"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "editorial_image_ratio",
      "label": "Feature image ratio",
      "options": [
        {
          "value": "4/5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "3/4",
          "label": "Tall portrait (3:4)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3/2",
          "label": "Landscape (3:2)"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill frame (crop)"
        },
        {
          "value": "contain",
          "label": "Fit entire image"
        }
      ],
      "default": "cover"
    }
  ],
  "presets": [
    {
      "name": "Lansattic One of a Kind"
    }
  ]
}
{% endschema %}
