{% render 'lansattic-home-styles', section: section %}
<div id="lh-{{section.id}}" class="lansattic-home-section">
<section class="lhs lhintent-section" id="shop-by-intention">
  <div class="lhw">
    <header class="lhhead"><p class="lhk">{{ section.settings.copy_1 | escape | newline_to_br }}</p><h2 class="lht">{{ section.settings.copy_2 | escape | newline_to_br }}</h2><p class="lhp">{{ section.settings.copy_3 | escape | newline_to_br }}</p></header>
    <div class="lhintentions">
      {% for i in (1..6) %}
        {% assign link_key = 'intention_link_' | append: i %}
        {% assign label_key = 'ints_' | append: i %}
        {% capture intention_label %}<span>0{{ i }}</span><b>{{ section.settings[label_key] | escape }}</b>{% endcapture %}
        {% assign destination = section.settings[link_key] %}
        {% capture destination_visible %}{% render 'lansattic-link-visible', url: destination %}{% endcapture %}
        {% if destination_visible != 'true' %}
          {% assign destination = section.settings.elements_link %}
          {% capture fallback_visible %}{% render 'lansattic-link-visible', url: destination %}{% endcapture %}
          {% if fallback_visible != 'true' %}{% assign destination = routes.all_products_collection_url %}{% endif %}
        {% endif %}
        <a class="lhintent" href="{{ destination | escape }}">{{ intention_label }}</a>
      {% endfor %}
    </div>
    {% if section.settings.elements_link != blank %}<div class="lhcta"><a class="lhbtn" href="{{ section.settings.elements_link | escape }}">Explore Five Elements</a></div>{% endif %}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Lansattic Intentions",
  "settings": [
