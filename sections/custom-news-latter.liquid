{% comment %}
  Lansattic Newsletter
  Save as: sections/lansattic-newsletter-section.liquid
{% endcomment %}

{%- style -%}
  #LansatticNewsletter-{{ section.id }} {
    --newsletter-bg: {{ section.settings.background_color }};
    --newsletter-text: {{ section.settings.text_color }};
    --newsletter-line: {{ section.settings.border_color }};
    --newsletter-button: {{ section.settings.button_color }};
    --newsletter-button-text: {{ section.settings.button_text_color }};
    background: var(--newsletter-bg);
    color: var(--newsletter-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #LansatticNewsletter-{{ section.id }} * { box-sizing: border-box; }

  #LansatticNewsletter-{{ section.id }} .ln__inner {
    width: min(calc(100% - 48px), {{ section.settings.max_width }}px);
    margin: 0 auto;
  }

  #LansatticNewsletter-{{ section.id }} .ln__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr);
    min-height: 410px;
    border-top: 1px solid var(--newsletter-line);
    border-bottom: 1px solid var(--newsletter-line);
  }

  #LansatticNewsletter-{{ section.id }} .ln__copy,
  #LansatticNewsletter-{{ section.id }} .ln__form-wrap {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 68px clamp(32px, 5vw, 92px);
  }

  #LansatticNewsletter-{{ section.id }} .ln__form-wrap {
    border-left: 1px solid var(--newsletter-line);
  }

  #LansatticNewsletter-{{ section.id }} .ln__eyebrow {
    margin: 0 0 18px;
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .22em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #LansatticNewsletter-{{ section.id }} .ln__heading {
    max-width: 720px;
    margin: 0;
    font-family: var(--heading-font-family);
    font-size: clamp(46px, 5vw, 76px);
    font-weight: 400;
    letter-spacing: -.035em;
    line-height: 1.02;
  }

  #LansatticNewsletter-{{ section.id }} .ln__text {
    max-width: 560px;
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.6;
  }

  #LansatticNewsletter-{{ section.id }} .ln__text p { margin: 0; }

  #LansatticNewsletter-{{ section.id }} .ln__form-title {
    margin: 0 0 22px;
    font-family: var(--heading-font-family);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
  }

  #LansatticNewsletter-{{ section.id }} .ln__field {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--newsletter-text);
  }

  #LansatticNewsletter-{{ section.id }} .ln__input {
    min-width: 0;
    flex: 1;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--newsletter-text);
    font: inherit;
    font-size: 15px;
    padding: 17px 10px 17px 0;
    box-shadow: none;
    outline: none;
  }

  #LansatticNewsletter-{{ section.id }} .ln__input::placeholder {
    color: var(--newsletter-text);
    opacity: .65;
  }

  #LansatticNewsletter-{{ section.id }} .ln__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 150px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--newsletter-text);
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .16em;
    padding: 0 0 0 22px;
    text-transform: uppercase;
  }

  #LansatticNewsletter-{{ section.id }} .ln__button svg {
    width: 18px;
    transition: transform .2s ease;
  }

  #LansatticNewsletter-{{ section.id }} .ln__button:hover svg,
  #LansatticNewsletter-{{ section.id }} .ln__button:focus-visible svg {
    transform: translateX(5px);
  }

  #LansatticNewsletter-{{ section.id }} .ln__button:focus-visible,
  #LansatticNewsletter-{{ section.id }} .ln__input:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #LansatticNewsletter-{{ section.id }} .ln__privacy {
    margin: 18px 0 0;
    font-size: 12px;
    line-height: 1.55;
    opacity: .75;
  }

  #LansatticNewsletter-{{ section.id }} .ln__privacy a {
    color: inherit;
    text-underline-offset: 3px;
  }

  #LansatticNewsletter-{{ section.id }} .ln__message {
    margin: 18px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }

  #LansatticNewsletter-{{ section.id }} .ln__message--error { color: #9c2e25; }

  #LansatticNewsletter-{{ section.id }} .ln__button--filled {
    min-height: 54px;
    margin-top: 18px;
    background: var(--newsletter-button);
    color: var(--newsletter-button-text);
    padding: 0 28px;
    transition: opacity .2s ease;
  }

  #LansatticNewsletter-{{ section.id }} .ln__button--filled:hover { opacity: .86; }

  #LansatticNewsletter-{{ section.id }} .ln__visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media screen and (max-width: 989px) {
    #LansatticNewsletter-{{ section.id }} .ln__panel { grid-template-columns: 1fr; }
    #LansatticNewsletter-{{ section.id }} .ln__form-wrap {
      border-top: 1px solid var(--newsletter-line);
      border-left: 0;
    }
  }

  @media screen and (max-width: 749px) {
    #LansatticNewsletter-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }
    #LansatticNewsletter-{{ section.id }} .ln__inner { width: calc(100% - 32px); }
    #LansatticNewsletter-{{ section.id }} .ln__panel { min-height: 0; }
    #LansatticNewsletter-{{ section.id }} .ln__copy,
    #LansatticNewsletter-{{ section.id }} .ln__form-wrap { padding: 42px 20px; }
    #LansatticNewsletter-{{ section.id }} .ln__heading { font-size: clamp(39px, 12vw, 54px); }
    #LansatticNewsletter-{{ section.id }} .ln__text { margin-top: 18px; font-size: 14px; }
    #LansatticNewsletter-{{ section.id }} .ln__form-title { font-size: 24px; }
    #LansatticNewsletter-{{ section.id }} .ln__field { display: block; border: 0; }
    #LansatticNewsletter-{{ section.id }} .ln__input {
      width: 100%;
      border-bottom: 1px solid var(--newsletter-text);
      padding: 16px 0;
    }
    #LansatticNewsletter-{{ section.id }} .ln__button {
      width: 100%;
      min-height: 52px;
      margin-top: 16px;
      background: var(--newsletter-button);
      color: var(--newsletter-button-text);
      padding: 0 22px;
    }
  }
{%- endstyle -%}

<section id="LansatticNewsletter-{{ section.id }}" aria-labelledby="NewsletterHeading-{{ section.id }}">
  <div{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} class="ln__inner" style="scroll-margin-top: 116px;">
    <div class="ln__panel">
      <div class="ln__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ln__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="NewsletterHeading-{{ section.id }}" class="ln__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ln__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="ln__form-wrap">
        {%- if section.settings.form_heading != blank -%}
          <h3 class="ln__form-title">{{ section.settings.form_heading | escape }}</h3>
        {%- endif -%}

        {%- form 'customer', id: 'LansatticNewsletterForm', class: 'ln__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="ln__field">
            <label class="ln__visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              class="ln__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocapitalize="off"
              autocomplete="email"
              autocorrect="off"
              placeholder="{{ section.settings.placeholder | escape }}"
              aria-required="true"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}
              {% if form.posted_successfully? %}aria-describedby="NewsletterSuccess-{{ section.id }}"{% endif %}
            >
            <button class="ln__button" type="submit" name="commit">
              <span>{{ section.settings.button_label | escape }}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>

          {%- if section.settings.privacy_text != blank -%}
            <div class="ln__privacy">{{ section.settings.privacy_text }}</div>
          {%- endif -%}

          {%- if form.errors -%}
            <div id="NewsletterError-{{ section.id }}" class="ln__message ln__message--error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <p id="NewsletterSuccess-{{ section.id }}" class="ln__message" role="status" tabindex="-1">
              {{ section.settings.success_message | escape }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lansattic newsletter",
  "tag": "section",
  "class": "section-lansattic-newsletter",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Homepage anchor ID", "info": "Use letters only, without #.", "default": "newsletter" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE LANSATTIC LETTER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories worth keeping close" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Receive considered notes on jade, symbolism, new pieces and the quiet rituals behind them.</p>" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Join our world" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you for joining the world of Lansattic." },
    { "type": "richtext", "id": "privacy_text", "label": "Privacy text", "default": "<p>By subscribing, you agree to receive Lansattic news and accept our privacy policy. You can unsubscribe at any time.</p>" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#315C4D" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F8F5EC" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#708B80" },
    { "type": "color", "id": "button_color", "label": "Mobile button", "default": "#F8F5EC" },
    { "type": "color", "id": "button_text_color", "label": "Mobile button text", "default": "#315C4D" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1800, "step": 20, "unit": "px", "label": "Maximum width", "default": 1700 },
    { "type": "range", "id": "padding_top", "min": 40, "max": 160, "step": 4, "unit": "px", "label": "Desktop top spacing", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 40, "max": 160, "step": 4, "unit": "px", "label": "Desktop bottom spacing", "default": 88 },
    { "type": "range", "id": "mobile_padding_top", "min": 24, "max": 100, "step": 4, "unit": "px", "label": "Mobile top spacing", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 24, "max": 100, "step": 4, "unit": "px", "label": "Mobile bottom spacing", "default": 48 }
  ],
  "presets": [
    { "name": "Lansattic newsletter" }
  ]
}
{% endschema %}
