{% render 'lansattic-home-styles', section: section %}
<div id="lh-{{section.id}}" class="lansattic-home-section">
<section class="lhsplit" id="about"><div class="lhsplitmedia">{% if section.settings.founder_image != blank %}{{section.settings.founder_image|image_url:width:1600|image_tag:loading:'lazy'}}{% elsif section.settings.founder_asset != blank %}{% render 'lansattic-archive-photo', asset: section.settings.founder_asset, alt: section.settings.founder_alt, loading: 'lazy' %}{% endif %}</div><div class="lhsplitbody"><p class="lhk">{{ section.settings.copy_1 | escape | newline_to_br }}</p><h2 class="lht">{{ section.settings.copy_2 | escape | newline_to_br }}</h2><p class="lhp">{{ section.settings.copy_3 | escape | newline_to_br }}</p><div><a class="lhbtn" href="{{ section.settings.about_link | default: '/pages/about-lansattic' }}">{{ section.settings.about_cta_label | default: 'Discover our story' }}</a></div></div></section>
</div>

{% schema %}
{
  "name": "Lansattic Founder story",
  "settings": [
    {
      "type": "textarea",
      "id": "copy_1",
      "label": "Text 1",
      "default": "Founder story"
    },
    {
      "type": "textarea",
      "id": "copy_2",
      "label": "Heading 2",
      "default": "A life shaped\nby jade"
    },
    {
      "type": "textarea",
      "id": "copy_3",
      "label": "Text 3",
      "default": "My relationship with jade began long before Lansattic. From growing up surrounded by jade, to searching for natural stones by the river; from journeys through Tibet and years of personal practice, to learning to weave beads by hand and years behind the counter, Lansattic grew slowly through materials, journeys, cultures, design and the people met along the way."
    },
    {
      "type": "text",
      "id": "about_cta_label",
      "label": "Story CTA text",
      "default": "DISCOVER OUR STORY"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "Story CTA link"
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder image"
    },
    {
      "type": "select",
      "id": "card_image_ratio",
      "label": "Card image ratio",
      "options": [
        {
          "value": "4/5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "3/4",
          "label": "Tall portrait (3:4)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3/2",
          "label": "Landscape (3:2)"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "editorial_image_ratio",
      "label": "Feature image ratio",
      "options": [
        {
          "value": "4/5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "3/4",
          "label": "Tall portrait (3:4)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3/2",
          "label": "Landscape (3:2)"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill frame (crop)"
        },
        {
          "value": "contain",
          "label": "Fit entire image"
        }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "founder_asset",
      "label": "Included photograph",
      "default": "lansattic-supplied-jade-heritage.jpg"
    },
    {
      "type": "text",
      "id": "founder_alt",
      "label": "Photograph description",
      "default": "Two generations wearing jade bangles, with their hands resting together."
    }
  ],
  "presets": [
    {
      "name": "Lansattic Founder story"
    }
  ]
}
{% endschema %}
