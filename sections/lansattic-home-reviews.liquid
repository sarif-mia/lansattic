{% render 'lansattic-home-styles', section: section %}
<div id="lh-{{section.id}}" class="lansattic-home-section">
<section class="lhs lhreviews"><div class="lhw"><header class="lhhead"><p class="lhk">{{ section.settings.copy_1 | escape | newline_to_br }}</p><h2 class="lht">{{ section.settings.copy_2 | escape | newline_to_br }}</h2><p class="lhp">{{ section.settings.copy_3 | escape | newline_to_br }}</p></header><div class="lhrgrid" data-review-slider><article class="lhr"><div class="lhstars">★★★★★</div><blockquote>{{ section.settings.copy_4 | escape | newline_to_br }}</blockquote><small>{{ section.settings.copy_5 | escape | newline_to_br }}</small></article><article class="lhr"><div class="lhstars">★★★★★</div><blockquote>{{ section.settings.copy_6 | escape | newline_to_br }}</blockquote><small>{{ section.settings.copy_7 | escape | newline_to_br }}</small></article><article class="lhr"><div class="lhstars">★★★★★</div><blockquote>{{ section.settings.copy_8 | escape | newline_to_br }}</blockquote><small>{{ section.settings.copy_9 | escape | newline_to_br }}</small></article></div><div class="lhrdots" aria-label="Customer review slides"><button type="button" class="is-active" aria-label="Review 1"></button><button type="button" aria-label="Review 2"></button><button type="button" aria-label="Review 3"></button></div><p class="lhtrust">{{ section.settings.copy_10 | escape | newline_to_br }}</p><div class="lhcta"><a class="lhbtn" href="{{section.settings.reviews_link}}">{{ section.settings.reviews_cta_label | default: 'Read More Reviews on Etsy' }}</a></div></div></section>
</div>
<script>
(function(){
  const root=document.getElementById('lh-{{ section.id }}'); if(!root) return;
  const slider=root.querySelector('[data-review-slider]'); if(!slider) return;
  const slides=[...slider.querySelectorAll('.lhr')], dots=[...root.querySelectorAll('.lhrdots button')];
  slider.classList.add('is-enhanced');
  let current=0,timer; const AUTOPLAY_MS=5000;
  function mobile(){return window.matchMedia('(max-width:749px)').matches}
  function show(i){current=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.classList.toggle('is-active',!mobile()||n===current));dots.forEach((d,n)=>d.classList.toggle('is-active',n===current))}
  function start(){clearInterval(timer);show(current);if(mobile()&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches)timer=setInterval(()=>show(current+1),AUTOPLAY_MS)}
  dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);start()}));
  slider.addEventListener('mouseenter',()=>clearInterval(timer));
  slider.addEventListener('focusin',()=>clearInterval(timer));
  window.addEventListener('resize',start); start();
})();
</script>
