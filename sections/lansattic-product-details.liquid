{% assign material = product.metafields.custom.material %}{% assign dimensions = product.metafields.custom.dimensions %}{% assign inspiration = product.metafields.custom.meaning_inspiration %}{% assign care = product.metafields.custom.care %}{% assign variation = product.metafields.custom.natural_variation %}{% assign certificate = product.metafields.custom.gemological_documentation %}
<style>#lpd-{{section.id}}{border-top:1px solid #ddd6c9;margin-top:35px}.lpd-row{border-bottom:1px solid #ddd6c9;padding:18px 0}.lpd-row summary{cursor:pointer;text-transform:uppercase;letter-spacing:.1em;font-size:11px}.lpd-body{padding:14px 0 4px;line-height:1.7;color:#555}.lpd-note{background:#f7f5ef;padding:20px;margin-top:20px;font-size:13px;line-height:1.6}</style>
<div id="lpd-{{section.id}}">{% if material != blank %}<details class="lpd-row" open><summary>Material</summary><div class="lpd-body">{{material | metafield_tag}}</div></details>{% endif %}{% if dimensions != blank %}<details class="lpd-row"><summary>Dimensions</summary><div class="lpd-body">{{dimensions | metafield_tag}}</div></details>{% endif %}<details class="lpd-row"><summary>Natural Variation</summary><div class="lpd-body">{% if variation != blank %}{{variation | metafield_tag}}{% else %}Because we work with natural materials, color, texture, pattern, shape, and translucency may vary slightly from piece to piece. These natural differences are part of the character of each piece.{% endif %}</div></details>{% if inspiration != blank %}<details class="lpd-row"><summary>Meaning / Inspiration</summary><div class="lpd-body">{{inspiration | metafield_tag}}</div></details>{% endif %}{% if care != blank %}<details class="lpd-row"><summary>Care</summary><div class="lpd-body">{{care | metafield_tag}}</div></details>{% endif %}<details class="lpd-row"><summary>Shipping & Returns</summary><div class="lpd-body">{{section.settings.shipping_returns}}</div></details>{% if certificate != blank %}<div class="lpd-note"><strong>Gemological documentation</strong><br>{{certificate | metafield_tag}}</div>{% endif %}</div>
{% schema %}{"name":"Lansattic product details","settings":[{"type":"richtext","id":"shipping_returns","label":"Shipping & returns","default":"<p>For delivery and return details, please contact us before ordering.</p>"}],"presets":[{"name":"Lansattic product details"}]}{% endschema %}
