{% render 'lansattic-home-styles', section: section %}
<div id="lh-{{section.id}}" class="lansattic-home-section">
<section class="lhs" id="shop"><div class="lhw"><header class="lhhead"><p class="lhk">{{ section.settings.copy_1 | escape | newline_to_br }}</p><h2 class="lht">{{ section.settings.copy_2 | escape | newline_to_br }}</h2><p class="lhp">{{ section.settings.copy_3 | escape | newline_to_br }}</p></header><div class="lhcards">{% for i in (1..6) %}{% assign ik='collection_image_'|append:i %}{% assign lk='collection_link_'|append:i %}{% assign ak='collection_asset_'|append:i %}{% assign tk='titles_'|append:i %}{% assign pk='collection_position_'|append:i %}<a class="lhcard"{% if forloop.first %} id="collectors-gallery"{% endif %} href="{{section.settings[lk]}}">{% if section.settings[ik] != blank %}{{section.settings[ik]|image_url:width:1000|image_tag:loading:'lazy'}}{% elsif section.settings[ak] != blank %}{% render 'lansattic-archive-photo', asset: section.settings[ak], alt: section.settings[tk], position: section.settings[pk], loading: 'lazy' %}{% else %}{{'image'|placeholder_svg_tag}}{% endif %}<div class="lhcardtext"><h3>{% assign editable_titles = 'titles_' | append: forloop.index %}{{ section.settings[editable_titles] | escape }}</h3><p>{% assign editable_descs = 'descs_' | append: forloop.index %}{{ section.settings[editable_descs] | escape }}</p></div></a>{% endfor %}</div></div></section>
</div>

