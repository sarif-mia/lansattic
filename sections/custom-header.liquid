    #{{ header_id }} .lh-mobile-submenu.is-open { max-height: 1000px; padding: 0 0 20px 14px; }
    #{{ header_id }} .lh-mobile-submenu a { display: block; padding: 7px 0; font-size: 14px; opacity: .78; }
    #{{ header_id }} .lh-mobile-submenu .lh-mobile-all { margin-bottom: 6px; font-weight: 700; opacity: 1; }
    #{{ header_id }} .lh-mobile-submenu .lh-mobile-grandchild { padding-left: 14px; font-size: 13px; }
    #{{ header_id }} .lh-mobile-group-title { display: block; margin: 18px 0 5px; color: var(--lh-accent); font-size: 10px; letter-spacing: .15em; text-transform: uppercase; }
    #{{ header_id }} .lh-drawer-footer { padding-top: 24px; display: flex; gap: 18px; border-top: 1px solid var(--lh-line); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById({{ header_id | json }});
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const drawer = root.querySelector('.lh-drawer');
    const opener = root.querySelector('[data-drawer-open]');
    const closers = root.querySelectorAll('[data-drawer-close]');

    const setDrawer = (open) => {
      root.classList.toggle('drawer-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      opener?.setAttribute('aria-expanded', String(open));
      drawer?.setAttribute('aria-hidden', String(!open));
      if (drawer) drawer.inert = !open;
      if (open) drawer?.querySelector('button')?.focus();
      else if (drawer?.contains(document.activeElement)) opener?.focus();
    };

    opener?.addEventListener('click', () => setDrawer(true));
    closers.forEach((button) => button.addEventListener('click', () => setDrawer(false)));

    const closeMega = () => {
      root.querySelectorAll('.lh-nav-item--mega.is-open').forEach((item) => {
        item.classList.remove('is-open');
        item.querySelector('[data-mega-toggle]')?.setAttribute('aria-expanded', 'false');
      });
    };

    root.querySelectorAll('[data-mega-toggle]').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const item = button.closest('.lh-nav-item--mega');
        const shouldOpen = !item?.classList.contains('is-open');
        closeMega();
        if (shouldOpen && item) {
          const headerBottom = root.querySelector('[data-header-main]')?.getBoundingClientRect().bottom || 114;
          root.style.setProperty('--lh-mega-top', `${Math.max(0, headerBottom)}px`);
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', (event) => { if (!root.contains(event.target)) closeMega(); });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && root.classList.contains('drawer-open')) {
        const focusable = [...drawer.querySelectorAll('a[href], button')].filter(el => el.getClientRects().length && !el.closest('.lh-mobile-submenu:not(.is-open)'));
        const first = focusable[0], last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
      if (event.key === 'Escape') {
        setDrawer(false);
        closeMega();
      }
    });

    root.querySelectorAll('.lh-mobile-submenu').forEach(el => el.inert = true);
    root.querySelectorAll('[data-mobile-submenu]').forEach((button) => {
      button.addEventListener('click', () => {
        const submenu = button.nextElementSibling;
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        submenu?.classList.toggle('is-open', open);
        if (submenu) submenu.inert = !open;
      });
    });

    root.querySelectorAll('a[href*="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        closeMega();
        const destination = new URL(link.href, window.location.href);
        const samePage = destination.origin === window.location.origin && destination.pathname === window.location.pathname;
        if (!samePage || !destination.hash) return;
        const target = document.getElementById(decodeURIComponent(destination.hash.slice(1)));
        if (!target) return;
        event.preventDefault();
        setDrawer(false);
        target.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        window.history.pushState({}, '', destination.hash);
      });
    });

    root.querySelectorAll('.lh-mega a').forEach((link) => link.addEventListener('click', closeMega));

    const onScroll = () => root.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>

