    #{{ header_id }} .lh-close { width: 40px; height: 40px; border: 0; background: none; color: inherit; font-size: 31px; font-weight: 200; line-height: 1; }
    #{{ header_id }} .lh-mobile-nav { flex: 1; padding-top: 18px; }
    #{{ header_id }} .lh-mobile-item { border-bottom: 1px solid var(--lh-line); }
    #{{ header_id }} .lh-mobile-parent { width: 100%; min-height: 58px; padding: 0; display: flex; align-items: center; justify-content: space-between; border: 0; background: none; color: inherit; font-family: var(--heading-font-family, Georgia, serif); font-size: 24px; text-align: left; }
    #{{ header_id }} .lh-mobile-parent span:last-child { font-family: Arial, sans-serif; font-size: 22px; font-weight: 300; transition: transform .25s; }
    #{{ header_id }} .lh-mobile-parent[aria-expanded='true'] span:last-child { transform: rotate(45deg); }
