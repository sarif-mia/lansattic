{% comment %}
  Lansattic Header + Mega Menu
  Install as: sections/lansattic-header-mega-menu.liquid
  Use once in the Header group. Disable the theme's original header.
{% endcomment %}

{% liquid
  assign header_id = 'lansattic-header-' | append: section.id
  assign main_menu = section.settings.menu
  assign trigger_handle = section.settings.mega_trigger | handleize
  assign custom_menu_links = section.blocks | where: 'type', 'menu_link'
  assign mega_column_blocks = section.blocks | where: 'type', 'mega_column'
  assign promotion_blocks = section.blocks | where: 'type', 'promotion'
%}

<div id="{{ header_id }}" class="lh-wrap{% if section.settings.transparent_home and template.name == 'index' %} lh-wrap--transparent{% endif %}" data-lansattic-header>
  {% if section.settings.show_announcement %}
    {% render 'lansattic-announcements', section: section %}
  {% endif %}

  <header class="lh-header" data-header-main>
    <div class="lh-container">
      <button class="lh-icon-button lh-mobile-trigger" type="button" aria-label="Open menu" aria-controls="lh-drawer-{{ section.id }}" aria-expanded="false" data-drawer-open>
        <span></span><span></span><span></span>
      </button>

      <nav class="lh-desktop-nav" aria-label="Primary navigation">
        {% if custom_menu_links.size > 0 %}
          {% for block in custom_menu_links %}
{% capture link_visible %}{% render 'lansattic-link-visible', url: block.settings.link %}{% endcapture %}{% if link_visible != 'true' %}{% continue %}{% endif %}
            <div class="lh-nav-item{% if block.settings.open_mega %} lh-nav-item--mega{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.open_mega %}
                <a data-mega-toggle class="lh-nav-link lh-mega-trigger" href="{{ block.settings.link | default: routes.root_url }}" aria-expanded="false">{{ block.settings.label | escape }}</a>
                <div class="lh-mega" aria-label="{{ block.settings.label | escape }} menu">
                  <div class="lh-mega-inner{% if promotion_blocks.size == 0 %} lh-mega-inner--links-only{% endif %}">
                    <div class="lh-mega-links lh-mega-links--{{ mega_column_blocks.size }}">
                      {% for column in mega_column_blocks %}
                        <div class="lh-mega-column" {{ column.shopify_attributes }}>
                          <p class="lh-mega-title">{{ column.settings.heading | escape }}</p>
                          {% assign menu_lines = column.settings.links | newline_to_br | split: '<br />' %}
                          {% for line in menu_lines %}
                            {% assign clean_line = line | strip %}
                            {% assign link_parts = clean_line | split: '|' %}
                            {% assign item_label = link_parts[0] | strip %}
                            {% assign item_url = link_parts[1] | strip %}
                            {% capture link_visible %}{% render 'lansattic-link-visible', url: item_url %}{% endcapture %}{% assign intention_names = 'Calm|Grounding|Balance|Clarity|Vitality|Connection' | split: '|' %}{% if intention_names contains item_label and link_visible != 'true' %}{% assign item_url = '/collections/five-elements-jewelry' %}{% capture link_visible %}{% render 'lansattic-link-visible', url: item_url %}{% endcapture %}{% if link_visible != 'true' %}{% assign item_url = routes.all_products_collection_url %}{% assign link_visible = 'true' %}{% endif %}{% endif %}{% if item_label != blank and item_url != blank and link_visible == 'true' %}<a href="{{ item_url | default: routes.all_products_collection_url }}">{{ item_label | escape }}</a>{% endif %}
                          {% endfor %}
                        </div>
                      {% endfor %}
                    </div>
                    {% if promotion_blocks.size > 0 %}
                      <div class="lh-mega-promos">
                        {% for promo in promotion_blocks limit: 1 %}
                          <a class="lh-promo" href="{{ promo.settings.link | default: routes.all_products_collection_url }}" {{ promo.shopify_attributes }}>
                            <div class="lh-promo-media">
                              {% if promo.settings.image != blank %}
                                {{ promo.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '280px', class: 'lh-promo-image', alt: promo.settings.heading }}
                              {% else %}
                                {{ 'collection-1' | placeholder_svg_tag: 'lh-promo-placeholder' }}
                              {% endif %}
                            </div>
                            {% if promo.settings.eyebrow != blank %}<span class="lh-promo-eyebrow">{{ promo.settings.eyebrow | escape }}</span>{% endif %}
                            {% if promo.settings.heading != blank %}<span class="lh-promo-heading">{{ promo.settings.heading | escape }}</span>{% endif %}
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% else %}
                <a class="lh-nav-link" href="{{ block.settings.link | default: routes.root_url }}">{{ block.settings.label | escape }}</a>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
        {% for link in main_menu.links %}{% if link.type == 'collection_link' and link.object.all_products_count == 0 %}{% continue %}{% endif %}
          {% liquid
            assign is_mega = false
            assign link_handle = link.title | handleize
            if link_handle == trigger_handle
              assign is_mega = true
            endif
          %}
          <div class="lh-nav-item{% if is_mega %} lh-nav-item--mega{% endif %}">
            <a class="lh-nav-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>

            {% if is_mega %}
              <div class="lh-mega" aria-label="{{ link.title | escape }} menu">
                <div class="lh-mega-inner{% if promotion_blocks.size == 0 %} lh-mega-inner--links-only{% endif %}">
                  <div class="lh-mega-links">
                    {% for childlink in link.links limit: 4 %}{% if childlink.type == 'collection_link' and childlink.object.all_products_count == 0 %}{% continue %}{% endif %}
                      <div class="lh-mega-column">
                        <a class="lh-mega-title" href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                        {% for grandchildlink in childlink.links %}{% if grandchildlink.type == 'collection_link' and grandchildlink.object.all_products_count == 0 %}{% continue %}{% endif %}
                          <a href="{{ grandchildlink.url }}"{% if grandchildlink.current %} aria-current="page"{% endif %}>{{ grandchildlink.title | escape }}</a>
                        {% endfor %}
                      </div>
                    {% endfor %}
                  </div>

                  {% if promotion_blocks.size > 0 %}<div class="lh-mega-promos">
                    {% for block in promotion_blocks %}
                      <a class="lh-promo" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
                        <div class="lh-promo-media">
                          {% if block.settings.image != blank %}
                            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '260px', class: 'lh-promo-image', alt: block.settings.heading }}
                          {% else %}
                            {{ 'collection-1' | placeholder_svg_tag: 'lh-promo-placeholder' }}
                          {% endif %}
                        </div>
                        {% if block.settings.eyebrow != blank %}<span class="lh-promo-eyebrow">{{ block.settings.eyebrow | escape }}</span>{% endif %}
                        {% if block.settings.heading != blank %}<span class="lh-promo-heading">{{ block.settings.heading | escape }}</span>{% endif %}
                      </a>
                    {% endfor %}
                  </div>{% endif %}
                </div>
              </div>
            {% elsif link.links != blank %}
              <div class="lh-dropdown">
                {% for childlink in link.links %}{% if childlink.type == 'collection_link' and childlink.object.all_products_count == 0 %}{% continue %}{% endif %}<a href="{{ childlink.url }}">{{ childlink.title | escape }}</a>{% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
        {% endif %}
      </nav>

      <a class="lh-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 560 | image_tag: loading: 'eager', widths: '180, 280, 420, 560', sizes: '220px', class: 'lh-logo-image', alt: shop.name }}
        {% else %}
          <span>{{ section.settings.logo_text | default: shop.name | escape }}</span>
        {% endif %}
      </a>

      <div class="lh-utilities">
        <a href="{{ routes.search_url }}" aria-label="Search" class="lh-utility lh-search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg><span>Search</span>
        </a>
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" aria-label="Account" class="lh-utility lh-account">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 20c.8-4 3-6 6.5-6s5.7 2 6.5 6"></path></svg><span>Account</span>
          </a>
        {% endif %}
        <a href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} items" class="lh-utility lh-cart">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"></path><path d="M9 9V6a3 3 0 0 1 6 0v3"></path></svg><span>Bag</span><b>{{ cart.item_count }}</b>
        </a>
      </div>
    </div>
  </header>

  <div class="lh-overlay" data-drawer-close></div>
  <aside id="lh-drawer-{{ section.id }}" class="lh-drawer" aria-hidden="true" role="dialog" aria-modal="true" inert aria-label="Mobile navigation">
    <div class="lh-drawer-head">
      <span class="lh-drawer-logo">{{ section.settings.logo_text | default: shop.name | escape }}</span>
      <button type="button" class="lh-close" aria-label="Close menu" data-drawer-close>×</button>
    </div>
    <nav class="lh-mobile-nav">
      {% if custom_menu_links.size > 0 %}
        {% for block in custom_menu_links %}
{% capture link_visible %}{% render 'lansattic-link-visible', url: block.settings.link %}{% endcapture %}{% if link_visible != 'true' %}{% continue %}{% endif %}
          <div class="lh-mobile-item" {{ block.shopify_attributes }}>
            {% if block.settings.open_mega %}
              <button type="button" class="lh-mobile-parent" aria-expanded="false" data-mobile-submenu>
                <span>{{ block.settings.label | escape }}</span><span aria-hidden="true">+</span>
              </button>
              <div class="lh-mobile-submenu">
                {% for column in mega_column_blocks %}
                  <strong class="lh-mobile-group-title">{{ column.settings.heading | escape }}</strong>
                  {% assign menu_lines = column.settings.links | newline_to_br | split: '<br />' %}
                  {% for line in menu_lines %}
                    {% assign clean_line = line | strip %}
                    {% assign link_parts = clean_line | split: '|' %}
                    {% assign item_label = link_parts[0] | strip %}
                    {% assign item_url = link_parts[1] | strip %}
                    {% capture link_visible %}{% render 'lansattic-link-visible', url: item_url %}{% endcapture %}{% assign intention_names = 'Calm|Grounding|Balance|Clarity|Vitality|Connection' | split: '|' %}{% if intention_names contains item_label and link_visible != 'true' %}{% assign item_url = '/collections/five-elements-jewelry' %}{% capture link_visible %}{% render 'lansattic-link-visible', url: item_url %}{% endcapture %}{% if link_visible != 'true' %}{% assign item_url = routes.all_products_collection_url %}{% assign link_visible = 'true' %}{% endif %}{% endif %}{% if item_label != blank and item_url != blank and link_visible == 'true' %}<a href="{{ item_url | default: routes.all_products_collection_url }}">{{ item_label | escape }}</a>{% endif %}
                  {% endfor %}
                {% endfor %}
              </div>
            {% else %}
              <a class="lh-mobile-parent" href="{{ block.settings.link | default: routes.root_url }}">{{ block.settings.label | escape }}</a>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
      {% for link in main_menu.links %}{% if link.type == 'collection_link' and link.object.all_products_count == 0 %}{% continue %}{% endif %}
        <div class="lh-mobile-item">
          {% if link.links != blank %}
            <button type="button" class="lh-mobile-parent" aria-expanded="false" data-mobile-submenu>
              <span>{{ link.title | escape }}</span><span aria-hidden="true">+</span>
            </button>
            <div class="lh-mobile-submenu">
              <a class="lh-mobile-all" href="{{ link.url }}">Shop all {{ link.title | escape }}</a>
              {% for childlink in link.links %}{% if childlink.type == 'collection_link' and childlink.object.all_products_count == 0 %}{% continue %}{% endif %}
                <a href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                {% for grandchildlink in childlink.links %}{% if grandchildlink.type == 'collection_link' and grandchildlink.object.all_products_count == 0 %}{% continue %}{% endif %}<a class="lh-mobile-grandchild" href="{{ grandchildlink.url }}">{{ grandchildlink.title | escape }}</a>{% endfor %}
              {% endfor %}
            </div>
          {% else %}
            <a class="lh-mobile-parent" href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endif %}
        </div>
      {% endfor %}
      {% endif %}
    </nav>
    <div class="lh-drawer-footer">
      <a href="{{ routes.search_url }}">Search</a>
      {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Account</a>{% endif %}
      <a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a>
    </div>
  </aside>
</div>

{% style %}
