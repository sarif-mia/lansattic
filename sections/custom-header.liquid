    #{{ header_id }} .lh-utilities { grid-column: 3; grid-row: 1; justify-self: end; gap: 12px; }
    #{{ header_id }} .lh-utility span, #{{ header_id }} .lh-account { display: none; }
    #{{ header_id }} .lh-utility svg { width: 20px; height: 20px; }
    #{{ header_id }} .lh-cart b { display: none; }
    #{{ header_id }} .lh-announcement { height: 32px; padding-inline: 8px; font-size: 9px; letter-spacing: .11em; line-height: 32px; }
    #{{ header_id }} .lh-announcement-message { inset-inline: 8px; }
    #{{ header_id }} .lh-overlay { position: fixed; inset: 0; z-index: 100; display: block; background: rgb(0 0 0 / 38%); opacity: 0; visibility: hidden; transition: .3s; }
    #{{ header_id }} .lh-drawer { width: min(90vw, 390px); height: 100dvh; padding: 0 24px 28px; position: fixed; inset: 0 auto 0 0; z-index: 101; display: flex; flex-direction: column; background: var(--lh-bg); color: var(--lh-text); transform: translateX(-102%); transition: transform .35s cubic-bezier(.22,.61,.36,1); overflow-y: auto; }
    #{{ header_id }}.drawer-open .lh-overlay { opacity: 1; visibility: visible; }
    #{{ header_id }}.drawer-open .lh-drawer { transform: translateX(0); }
