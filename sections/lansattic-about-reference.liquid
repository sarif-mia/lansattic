{% if section.settings.page_handle == blank or page.handle == section.settings.page_handle %}
{% style %}
#lar-{{ section.id }} { --about-paper:{{ section.settings.background }}; --about-ink:{{ section.settings.text_color }}; --about-gap:{{ section.settings.section_gap }}px; background:var(--about-paper); color:var(--about-ink); }
#lar-{{ section.id }} .lar-hero { background:{{ section.settings.hero_background }}; color:{{ section.settings.hero_text_color }}; }
#lar-{{ section.id }} .lar-hero-inner { width:min(100% - 96px,{{ section.settings.content_width }}px); margin:auto; display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:64px; padding:var(--lansattic-section-space) 0; }
#lar-{{ section.id }} .lar-hero-copy { padding:0; }
#lar-{{ section.id }} .lar-hero-media { display:flex; justify-content:center; }
#lar-{{ section.id }} .lar-hero-media img { display:block; width:auto; max-width:100%; height:auto; max-height:{{ section.settings.hero_height }}px; object-fit:contain; }
#lar-{{ section.id }} .lar-kicker { font-size:11px; letter-spacing:.17em; text-transform:uppercase; margin:0 0 24px; }
#lar-{{ section.id }} .lar-title { font-family:var(--heading-font-family); font-weight:400; font-size:clamp(40px,4.6vw,70px); line-height:1.08; margin:0 0 28px; }
#lar-{{ section.id }} .lar-hero-intro { font-size:16px; line-height:1.7; max-width:440px; }
#lar-{{ section.id }} .lar-hero-intro p + p { margin-top:18px; }
#lar-{{ section.id }} .lar-wrap { width:min(100% - 96px,{{ section.settings.content_width }}px); margin:auto; padding:0; }
#lar-{{ section.id }} .lar-row { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:64px; align-items:center; padding:var(--about-gap) 0; border-bottom:1px solid #ded9cf; }
#lar-{{ section.id }} .lar-row:last-child { border-bottom:0; }
#lar-{{ section.id }} .lar-row--image-left .lar-gallery { order:-1; }
#lar-{{ section.id }} .lar-row--text { display:block; max-width:800px; margin:auto; text-align:center; }
#lar-{{ section.id }} .lar-heading { font-family:var(--heading-font-family); font-size:clamp(26px,2.4vw,36px); font-weight:400; line-height:1.2; margin:0 0 24px; }
#lar-{{ section.id }} .lar-heading--sans { font-family:var(--text-font-family); font-size:23px; font-weight:500; }
#lar-{{ section.id }} .lar-heading-place, #lar-{{ section.id }} .lar-heading-subtitle { display:block; }
#lar-{{ section.id }} .lar-heading-place--uppercase { text-transform:uppercase; }
#lar-{{ section.id }} .lar-heading-subtitle { margin-top:10px; font-size:.78em; }
#lar-{{ section.id }} .lar-copy { font-size:{{ section.settings.body_size }}px; line-height:1.75; }
#lar-{{ section.id }} .lar-copy p { margin:0 0 18px; }
#lar-{{ section.id }} .lar-copy p:last-child { margin-bottom:0; }
#lar-{{ section.id }} .lar-copy h3 { font-family:var(--text-font-family); font-size:17px; font-weight:500; margin:26px 0 14px; }
#lar-{{ section.id }} .lar-copy a { text-decoration:underline; text-underline-offset:4px; }
#lar-{{ section.id }} .lar-gallery { margin:0; display:grid; gap:16px; }
#lar-{{ section.id }} .lar-media img { display:block; width:100%; height:auto; }
#lar-{{ section.id }} .lar-media--framed { aspect-ratio:var(--about-image-ratio); }
#lar-{{ section.id }} .lar-media--framed img { width:100%; height:100%; object-fit:var(--about-image-fit); }
#lar-{{ section.id }} .lar-caption { font-size:11px; line-height:1.5; letter-spacing:.04em; color:#626459; }
#lar-{{ section.id }} a.lar-link { display:inline-flex; align-items:center; min-height:44px; margin-top:18px; border-bottom:1px solid; text-decoration:none; font-size:12px; letter-spacing:.06em; text-transform:uppercase; }
@media(max-width:749px) {
 #lar-{{ section.id }} .lar-hero-inner { width:calc(100% - 40px); grid-template-columns:1fr; gap:28px; padding:var(--lansattic-section-space) 0; }
 #lar-{{ section.id }} .lar-hero-copy { padding:0; }
 #lar-{{ section.id }} .lar-title { font-size:42px; margin-bottom:22px; }
 #lar-{{ section.id }} .lar-hero-media img { max-height:{{ section.settings.hero_height_mobile }}px; }
 #lar-{{ section.id }} .lar-wrap { width:calc(100% - 40px); padding:0; }
 #lar-{{ section.id }} .lar-row { display:flex; flex-direction:column; align-items:stretch; gap:0; padding:var(--lansattic-section-space) 0; }
 #lar-{{ section.id }} .lar-content { display:contents; }
 #lar-{{ section.id }} .lar-heading { order:0; font-size:27px; margin:0 0 24px; }
 #lar-{{ section.id }} .lar-gallery, #lar-{{ section.id }} .lar-row--image-left .lar-gallery { order:1; width:100%; margin:0 0 24px; }
 #lar-{{ section.id }} .lar-copy { order:2; font-size:16px; line-height:1.7; }
 #lar-{{ section.id }} .lar-row--image-after-text .lar-copy { order:1; }
 #lar-{{ section.id }} .lar-row--image-after-text .lar-gallery { order:2; margin:24px 0 0; }
 #lar-{{ section.id }} .lar-row--text { text-align:left; }
}
{% endstyle %}
<section id="lar-{{ section.id }}">
 <header class="lar-hero"><div class="lar-hero-inner">
  <div class="lar-hero-copy">
   {% if section.settings.kicker != blank %}<p class="lar-kicker">{{ section.settings.kicker | escape }}</p>{% endif %}
   <h1 class="lar-title">{{ section.settings.title | escape | newline_to_br }}</h1>
   <div class="lar-hero-intro">{{ section.settings.intro }}</div>
   <a class="lar-link" href="#lar-story-{{ section.id }}">Discover our story</a>
  </div>
  <div class="lar-hero-media">{% render 'lansattic-archive-photo', image: section.settings.hero_image, asset: section.settings.hero_asset, alt: section.settings.hero_alt, loading: 'eager' %}</div>
 </div></header>
 <div class="lar-wrap" id="lar-story-{{ section.id }}">
  {% for block in section.blocks %}
   {% liquid
    assign has_image = false
    if block.settings.image != blank or block.settings.image_asset != blank or block.settings.image_2 != blank or block.settings.image_asset_2 != blank or block.settings.image_3 != blank or block.settings.image_asset_3 != blank
     assign has_image = true
    endif
   %}
   <article class="lar-row lar-row--image-{{ block.settings.image_side }}{% unless has_image %} lar-row--text{% endunless %}{% if block.settings.mobile_image_order == 'after_text' %} lar-row--image-after-text{% endif %}" style="--about-image-ratio:{{ block.settings.image_ratio }};--about-image-fit:{{ block.settings.image_fit }};" {{ block.shopify_attributes }}>
    <div class="lar-content">
     <h2 class="lar-heading{% if block.settings.heading_font == 'sans' %} lar-heading--sans{% endif %}"><span class="lar-heading-place{% if block.settings.uppercase_heading %} lar-heading-place--uppercase{% endif %}">{{ block.settings.heading | escape }}</span>{% if block.settings.subheading != blank %}<span class="lar-heading-subtitle">{{ block.settings.subheading | escape }}</span>{% endif %}</h2>
     <div class="lar-copy">{{ block.settings.text }}{% if block.settings.link != blank and block.settings.link_label != blank %}<a class="lar-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>
    </div>
    {% if has_image %}<figure class="lar-gallery">
     {% for photo_index in (1..3) %}
      {% liquid
       assign image_key = 'image'
       assign asset_key = 'image_asset'
       assign alt_key = 'image_alt'
       if photo_index > 1
        assign image_key = image_key | append: '_' | append: photo_index
        assign asset_key = asset_key | append: '_' | append: photo_index
        assign alt_key = alt_key | append: '_' | append: photo_index
       endif
      %}
      {% if block.settings[image_key] != blank or block.settings[asset_key] != blank %}<div class="lar-media{% if block.settings.image_ratio != 'reference' %} lar-media--framed{% endif %}">{% render 'lansattic-archive-photo', image: block.settings[image_key], asset: block.settings[asset_key], alt: block.settings[alt_key], loading: 'lazy' %}</div>{% endif %}
     {% endfor %}
     {% if block.settings.caption != blank %}<figcaption class="lar-caption">{{ block.settings.caption | escape }}</figcaption>{% endif %}
    </figure>{% endif %}
   </article>
  {% endfor %}
 </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Lansattic Our Story",
  "settings": [
    {
      "type": "text",
      "id": "page_handle",
      "label": "Page handle",
      "default": "about-lansattic"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Replace hero photo",
      "info": "Overrides the supplied founder archive photograph."
    },
    {
      "type": "text",
      "id": "hero_asset",
      "label": "Included founder photograph",
      "default": "lansattic-archive-founder-archive.jpeg",
      "info": "Theme asset filename. Use the image picker above to replace it."
    },
    {
      "type": "text",
      "id": "hero_alt",
      "label": "Hero image description",
      "default": "The founder selecting jewelry, from the Lansattic archive."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Small heading",
      "default": "About Us"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Jewelry With\nMeaning"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Rooted in nature. Shaped by Eastern wisdom.<br>Made to be lived with.</p>"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Photo height — desktop",
      "min": 300,
      "max": 700,
      "step": 20,
      "default": 460,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "label": "Photo height — mobile",
      "min": 320,
      "max": 640,
      "step": 20,
      "default": 440,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 960,
      "max": 1400,
      "step": 20,
      "default": 1180,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Desktop section spacing",
      "min": 20,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Desktop body text",
      "min": 14,
      "max": 20,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Page background",
      "default": "#f7f5ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#24251f"
    },
    {
      "type": "color",
      "id": "hero_background",
      "label": "Hero background",
      "default": "#eeebe2"
    },
    {
      "type": "color",
      "id": "hero_text_color",
      "label": "Hero text",
      "default": "#24251f"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Story chapter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Chapter heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Second heading line"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Story"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Replace chapter photo",
          "info": "Overrides the included archive photograph."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photo description"
        },
        {
          "type": "select",
          "id": "image_side",
          "label": "Desktop image side",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "right"
        },
        {
          "type": "select",
          "id": "mobile_image_order",
          "label": "Mobile image position",
          "options": [
            {
              "value": "after_heading",
              "label": "After heading"
            },
            {
              "value": "after_text",
              "label": "After text"
            }
          ],
          "default": "after_heading"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image ratio",
          "options": [
            {
              "value": "reference",
              "label": "Original photo proportions"
            },
            {
              "value": "1/1",
              "label": "Square (1:1)"
            },
            {
              "value": "4/5",
              "label": "Portrait (4:5)"
            },
            {
              "value": "4/3",
              "label": "Landscape (4:3)"
            },
            {
              "value": "3/2",
              "label": "Landscape (3:2)"
            },
            {
              "value": "16/9",
              "label": "Wide (16:9)"
            }
          ],
          "default": "reference"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image fit",
          "options": [
            {
              "value": "cover",
              "label": "Fill frame"
            },
            {
              "value": "contain",
              "label": "Fit entire photo"
            }
          ],
          "default": "cover"
        },
        {
          "type": "select",
          "id": "heading_font",
          "label": "Heading font",
          "options": [
            {
              "value": "serif",
              "label": "Editorial serif"
            },
            {
              "value": "sans",
              "label": "Clean sans serif"
            }
          ],
          "default": "serif"
        },
        {
          "type": "checkbox",
          "id": "uppercase_heading",
          "label": "Uppercase first heading line",
          "default": false
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Included photo asset"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Second photograph"
        },
        {
          "type": "text",
          "id": "image_asset_2",
          "label": "Included second photo asset"
        },
        {
          "type": "text",
          "id": "image_alt_2",
          "label": "Second photo description"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Third photograph"
        },
        {
          "type": "text",
          "id": "image_asset_3",
          "label": "Included third photo asset"
        },
        {
          "type": "text",
          "id": "image_alt_3",
          "label": "Third photo description"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Archive caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lansattic Our Story"
    }
  ]
}
{% endschema %}
